{
  "name": "site-darkmode",
  "version": "1.0.2",
  "description": "Fork of @quartz-community/darkmode: light by default, remembers the toggle, ignores OS theme changes.",
  "type": "module",
  "license": "MIT",
  "author": "Quartz Community",
  "homepage": "https://github.com/quartz-community/darkmode",
  "repository": {
    "type": "git",
    "url": "https://github.com/quartz-community/darkmode"
  },
  "keywords": [
    "quartz",
    "quartz-plugin",
    "darkmode",
    "theme",
    "component"
  ],
  "files": [
    "dist",
    "LICENSE"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./components": {
      "types": "./dist/components/index.d.ts",
      "import": "./dist/components/index.js"
    },
    "./package.json": "./package.json"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "sideEffects": false,
  "peerDependencies": {
    "preact": "^10.0.0"
  },
  "peerDependenciesMeta": {
    "preact": {
      "optional": false
    }
  },
  "dependencies": {
    "@quartz-community/types": "^1.0.0",
    "@quartz-community/utils": "^1.0.0"
  },
  "engines": {
    "node": ">=22",
    "npm": ">=10.9.2"
  },
  "quartz": {
    "name": "darkmode",
    "displayName": "Dark Mode",
    "category": "component",
    "version": "1.0.0",
    "quartzVersion": ">=5.0.0",
    "dependencies": [],
    "defaultOrder": 50,
    "defaultEnabled": true,
    "defaultOptions": {},
    "components": {
      "Darkmode": {
        "displayName": "Dark Mode",
        "defaultPosition": "left",
        "defaultPriority": 30
      }
    }
  },
  "publishConfig": {
    "access": "public"
  }
}
